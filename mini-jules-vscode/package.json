{
  "name": "mini-jules",
  "displayName": "Mini Jules",
  "publisher": "jules-autonomous",
  "description": "Autonomous Multi-File Project Generator",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mini-jules-explorer",
          "title": "Mini Jules",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mini-jules-explorer": [
        {
          "id": "mini-jules-sidebar",
          "type": "webview",
          "title": "Jules Control"
        }
      ]
    },
    "commands": [
      {
        "command": "MiniJules.Generate",
        "title": "Jules: Generate Project"
      },
      {
        "command": "MiniJules.Critique",
        "title": "Jules: Critique File"
      },
      {
        "command": "MiniJules.Repair",
        "title": "Jules: Repair File"
      },
      {
        "command": "MiniJules.ApplyPatch",
        "title": "Jules: Apply Patch"
      },
      {
        "command": "MiniJules.Manifest",
        "title": "Jules: Show Manifest"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.x"
  }
}
